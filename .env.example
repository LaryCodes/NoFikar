NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: TURN relay for consented camera/microphone sessions.
# WebRTC uses public STUN by default, which works on most Wi-Fi and many mobile
# networks. Strict carrier NAT needs a relay. Comma-separate multiple URLs.
# These are public client credentials by design — never put a service-role key here.
# NEXT_PUBLIC_TURN_URLS=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
